#! /usr/bin/env python3
import signal
import sys

from jupedsim_visualizer.main_window import MainWindow
from PySide6.QtCore import QTimer
from PySide6.QtWidgets import QApplication

if __name__ == "__main__":
    app = QApplication(sys.argv)
    # Default Qt behavior, but be explicit: closing the last window quits.
    app.setQuitOnLastWindowClosed(True)

    # Let Ctrl-C reach Python. Without this, Qt's native event loop swallows
    # SIGINT and the process hangs. The no-op QTimer wakes the loop often
    # enough for Python's signal handler to fire.
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    keepalive = QTimer()
    keepalive.start(100)
    keepalive.timeout.connect(lambda: None)

    window = MainWindow()
    sys.exit(app.exec())
